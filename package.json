{
  "name": "neuraforge-ai",
  "version": "1.2.0",
  "description": "44 agents, 39 skills and architecture rules for Claude Code, Kiro, Gemini CLI, Codex, Antigravity, Cursor and Copilot. One install writes each tool's native layout for .NET, NestJS, React, React Native, Flutter, Django and Spring Boot.",
  "type": "module",
  "bin": {
    "neuraforge": "install.mjs",
    "neuraforge-ai": "install.mjs"
  },
  "scripts": {
    "install:claude": "node install.mjs claude",
    "install:cursor": "node install.mjs cursor",
    "install:gemini": "node install.mjs gemini",
    "install:kiro": "node install.mjs kiro",
    "install:copilot": "node install.mjs copilot",
    "install:codex": "node install.mjs codex",
    "install:opencode": "node install.mjs opencode",
    "install:auto": "node install.mjs",
    "doctor": "node install.mjs --doctor",
    "dry-run": "node install.mjs --dry-run",
    "validate": "node --input-type=module < validate.mjs 2>/dev/null || python3 -m pytest .github/workflows/ 2>/dev/null || echo 'Run CI locally: act -j validate'",
    "feedback": "node tools/feedback/index.mjs",
    "feedback:init": "node tools/feedback/index.mjs init",
    "feedback:list": "node tools/feedback/index.mjs list",
    "feedback:submit": "node tools/feedback/index.mjs submit",
    "feedback:clean": "node tools/feedback/index.mjs clean",
    "feedback:lessons": "node tools/feedback/index.mjs lessons",
    "normalize:agents": "node tools/normalize-agents/index.mjs",
    "test:install": "node --test tools/install/adapters.test.mjs",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "verify:generated": "node tools/verify/post-gen-check.mjs",
    "eval:behavior": "node tools/eval/behavior/index.mjs",
    "eval": "node tools/eval/index.mjs",
    "eval:agent": "node tools/eval/index.mjs --agent",
    "prepublishOnly": "node --test tools/install/adapters.test.mjs tools/install/pack.test.mjs"
  },
  "keywords": [
    "cursor-rules",
    "claude-code",
    "copilot-instructions",
    "ai-agents",
    "llm",
    "prompt-engineering",
    "code-generation",
    "mcp",
    "nestjs",
    "dotnet",
    "react",
    "flutter",
    "django",
    "spring-boot",
    "react-native",
    "ai-rules",
    "cursor",
    "gemini",
    "kiro",
    "copilot",
    "codex",
    "antigravity",
    "agents-md",
    "agent-skills",
    "subagents",
    "code-review",
    "windows"
  ],
  "author": "Vikas Singh <vikisingh23@github.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/vikisingh23/neuraforge-ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vikisingh23/neuraforge-ai.git"
  },
  "bugs": {
    "url": "https://github.com/vikisingh23/neuraforge-ai/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "agents/",
    "rules/",
    "skills/",
    "presets/",
    "examples/",
    "tools/install/adapters.mjs",
    "tools/verify/post-gen-check.mjs",
    "tools/feedback/index.mjs",
    ".cursor/",
    ".gemini/",
    ".neuraforge/feedback/TEMPLATE.md",
    "AGENTS.md",
    "GEMINI.md",
    "SKILLS.md",
    "DESIGN.md",
    "CHANGELOG.md",
    ".mcp.json",
    ".neuraforge.yml",
    "install.mjs",
    "install.sh"
  ]
}
