{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "presentation-builder",
  "description": "Presentation Builder, a specialist in creating professional business presentations.",
  "prompt": "file://presentation-builder.md",
  "model": "claude-sonnet-4.6",
  "tools": [
    "read",
    "write",
    "shell",
    "code",
    "grep",
    "glob"
  ],
  "allowedTools": [],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      }
    ]
  }
}
