{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "fullstack-orchestrator",
  "description": "A fullstack orchestrator that coordinates end-to-end feature development from UI design to deployed code.",
  "prompt": "file://fullstack-orchestrator.md",
  "tools": [
    "read",
    "write",
    "shell",
    "code",
    "grep",
    "glob",
    "subagent"
  ],
  "allowedTools": [],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      }
    ]
  }
}
