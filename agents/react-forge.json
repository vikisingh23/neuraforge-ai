{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "react-forge",
  "description": "Generate production-ready React code following your project's patterns with React Query, proper component architecture, Figma-based UI, and complete CRUD features.",
  "prompt": "file://react-forge.md",
  "tools": [
    "read",
    "write",
    "shell",
    "code",
    "grep",
    "glob",
    "subagent"
  ],
  "allowedTools": [],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      }
    ]
  }
}
