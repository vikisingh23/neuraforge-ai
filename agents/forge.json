{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "forge",
  "description": "Generate production-ready .NET code following your project's patterns, build it, fix errors, and orchestrate testing.",
  "prompt": "file://forge.md",
  "tools": [
    "read",
    "write",
    "shell",
    "code",
    "grep",
    "glob",
    "subagent"
  ],
  "allowedTools": [],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      }
    ]
  }
}
