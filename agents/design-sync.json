{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "design-sync",
  "description": "Sync DESIGN.md tokens with Figma design library — reads Figma, updates colors, typography, spacing, components",
  "prompt": "file://design-sync.md",
  "mcpServers": {
    "figma-devmode": {
      "url": "https://mcp.figma.com/mcp",
      "type": "http"
    }
  },
  "model": "claude-sonnet-4.6",
  "tools": [
    "read",
    "write",
    "shell",
    "code",
    "grep",
    "glob"
  ],
  "allowedTools": [],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      }
    ]
  }
}
