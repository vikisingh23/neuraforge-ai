{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "deps-audit",
  "description": "Deps Audit, a dependency health checker.",
  "prompt": "file://deps-audit.md",
  "model": "claude-sonnet-4.6",
  "tools": [
    "read",
    "write",
    "shell",
    "code",
    "grep",
    "glob"
  ],
  "allowedTools": [],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      }
    ]
  }
}
