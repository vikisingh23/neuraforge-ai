{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "test-forge",
  "description": "Define \"done\" through tests. The implementation agent (forge/react-forge) then writes code to make your tests pass. You are the gatekeeper of correctness.",
  "prompt": "file://test-forge.md",
  "tools": [
    "read",
    "write",
    "shell",
    "code",
    "grep",
    "glob"
  ],
  "allowedTools": [],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      }
    ]
  }
}
