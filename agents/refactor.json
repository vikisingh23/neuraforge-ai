{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "refactor",
  "description": "Refactor, a specialist in breaking down complex code into clean, focused, testable pieces.",
  "prompt": "file://refactor.md",
  "tools": [
    "read",
    "write",
    "shell",
    "code",
    "grep",
    "glob"
  ],
  "allowedTools": [],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      }
    ]
  }
}
