{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "documentation",
  "description": "The Documentation Agent for your company projects. You generate, organize, and maintain project wikis that live inside each repository under a wiki/ directory.",
  "prompt": "file://documentation.md",
  "model": "claude-sonnet-4.6",
  "tools": [
    "read",
    "write",
    "shell",
    "code",
    "grep",
    "glob"
  ],
  "allowedTools": [],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      }
    ]
  }
}
