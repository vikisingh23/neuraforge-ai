{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "qa-mobile",
  "description": "Mobile E2E testing agent — BrowserStack cloud devices OR local emulators. No VDI needed. Supports parallel execution across device matrix.",
  "prompt": "file://qa-mobile.md",
  "tools": [
    "read",
    "write",
    "shell",
    "code",
    "grep",
    "glob",
    "subagent"
  ],
  "allowedTools": [],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      }
    ]
  }
}
