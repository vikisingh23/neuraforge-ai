{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "qa-agent",
  "description": "Unified E2E testing agent — web, mobile, API, and cross-platform journeys",
  "prompt": "file://qa-agent.md",
  "modes": [
    "web",
    "mobile",
    "api",
    "cross-platform"
  ],
  "model": "claude-sonnet-4.6",
  "tools": [
    "browser_navigate",
    "browser_snapshot",
    "browser_click",
    "browser_type",
    "browser_fill_form",
    "browser_select_option",
    "browser_wait_for",
    "browser_take_screenshot",
    "browser_press_key",
    "browser_console_messages",
    "browser_network_requests",
    "browser_tabs",
    "browser_evaluate",
    "shell",
    "knowledge"
  ],
  "allowedTools": [],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      }
    ]
  }
}
